// ========== Standard Unicode Icons (no special font needed) ==========
// These work on all systems - geometric shapes, arrows, box drawing
// Unicode blocks: Arrows (U+2190), Geometric (U+25A0), Box Drawing (U+2500)

// File/Folder icons (Box Drawing)
#define ICON_FOLDER "\xe2\x94\x98\xe2\x95\x93"      // ┌┐ folder shape
#define ICON_FILE "\xe2\x94\x8c\xe2\x95\x90"       // ┌┐ file shape
#define ICON_CUBE "\xe2\x96\x93"                 // ■ filled square
#define ICON_DOC "\xe2\x93\x82"                  // ▼ right triangle

// Actions
#define ICON_PLUS "\xe2\x9c\x93"                  // ✓ checkmark
#define ICON_MINUS "\xe2\x9e\x96"                // ➖ minus
#define ICON_TIMES "\xe2\x9c\x97"                  // ✗ cross
#define ICON_CHECK "\xe2\x9c\x85"                 // ✓ check
#define ICON_STAR "\xe2\xad\x90"                  // ★ star

// Media (Geometric shapes)  
#define ICON_PLAY "\xe2\x96\xb6"                 // ▶ play triangle
#define ICON_PAUSE "\xe2\x9c\xa6"                 // ❖ pause diamond
#define ICON_STOP "\xe2\x96\x91"                   // ■ square
#define ICON_RECORD "\xe2\x97\x8f"                // ◉ bullseye

// Navigation (Arrows)
#define ICON_HOME "\xe2\x8f\xa3"                  // ⏣ home
#define ICON_ARROW_LEFT "\xe2\x86\x90"             // ← arrow
#define ICON_ARROW_RIGHT "\xe2\x86\x92"            // → arrow  
#define ICON_UP "\xe2\x86\x91"                    // ↑ arrow
