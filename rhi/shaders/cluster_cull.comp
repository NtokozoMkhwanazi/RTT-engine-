#version 460
/**
 * cluster_cull.comp — GPU-Driven Cluster Frustum Culling (Phase 2)
 *
 * Reads every 128-triangle cluster's bounding sphere, tests it against the 6
 * camera frustum planes, and emits an VkDrawIndexedIndirectCommand for each
 * visible cluster via an atomic counter.  The resulting buffer is consumed by
 * a single vkCmdDrawIndexedIndirect call (Multi-Draw Indirect).
 *
 * Struct layout MUST match the host C++ structs in meshSystem/Mesh.h:
 *   GPUClusterBounds  (3 × vec4, std140)  — sphere + AABB
 *   GPUClusterCommand  (4 × uint, std430) — firstVertex/firstIndex/indexCount/instanceId
 *   ClusterIndirectCommand (VkDrawIndexedIndirectCommand, 20 B)
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --- Cluster bounds (read-only) ---
struct ClusterBounds {
    vec4 sphereCenterRadius;  // xyz = center, w = radius
    vec4 minBounds;           // xyz = min, w = padding
    vec4 maxBounds;           // xyz = max, w = padding
};

// --- Per-cluster draw metadata (read-only) ---
struct ClusterCommand {
    uint firstVertex;
    uint firstIndex;
    uint indexCount;
    uint instanceId;
};

// --- Output: VkDrawIndexedIndirectCommand (20 bytes, 4-byte aligned) ---
struct IndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

// --- Descriptor set 0 ---
layout(set = 0, binding = 0) uniform CameraUBO {
    mat4  viewProj;
    vec3  camPos;
    float fogDensity;
    vec3  fogColor;
} cam;

layout(set = 0, binding = 1, std430) readonly buffer ClusterBoundsBuffer {
    ClusterBounds bounds[];
} inBounds;

layout(set = 0, binding = 2, std430) readonly buffer ClusterCommandBuffer {
    ClusterCommand cmds[];
} inCommands;

// --- Outputs (atomic) ---
layout(set = 0, binding = 3, std430) writeonly buffer IndirectDrawBuffer {
    IndirectCommand drawCmds[];
} outDraws;

layout(set = 0, binding = 4, std430) buffer QueueCounter {
    uint drawCount;          // atomic counter: how many clusters passed
} outCounter;

// --- Push constant: total number of clusters + viewport params ---
layout(push_constant) uniform PushConstants {
    uint   totalClusters;
    float  viewportW;
    float  viewportH;
    float  lodPixelError;
} pc;

/*
 * Extract 6 frustum planes from the viewProj matrix (world-space, normals
 * pointing inward).  Plane order: [0]=left [1]=right [2]=bottom [3]=top [4]=near [5]=far
 * Each plane: (a, b, c, d) where dot((a,b,c), P) + d = 0, normalized.
 */
vec4 extractFrustumPlane(int which) {
    vec4 rowX = cam.viewProj[0];
    vec4 rowY = cam.viewProj[1];
    vec4 rowZ = cam.viewProj[2];
    vec4 rowW = cam.viewProj[3];

    vec4 plane;
    if      (which == 0) plane = rowW + rowX;  // left
    else if (which == 1) plane = rowW - rowX;  // right
    else if (which == 2) plane = rowW + rowY;  // bottom
    else if (which == 3) plane = rowW - rowY;  // top
    else if (which == 4) plane = rowW + rowZ;  // near
    else            plane = rowW - rowZ;  // far

    float invLen = 1.0 / length(plane.xyz);
    return plane * invLen;
}

/*
 * Sphere-against-frustum test.
 * Returns true if the bounding sphere is INSIDE or STRADDLING all 6 planes.
 */
bool sphereInFrustum(vec3 center, float radius) {
    for (int i = 0; i < 6; ++i) {
        vec4 plane = extractFrustumPlane(i);
        if (dot(plane.xyz, center) + plane.w < -radius)
            return false;
    }
    return true;
}

void main() {
    uint gId = gl_GlobalInvocationID.x;
    if (gId >= pc.totalClusters) return;

    vec4 sphere = inBounds.bounds[gId].sphereCenterRadius;
    vec3 center = sphere.xyz;
    float radius = sphere.w;

    bool visible = sphereInFrustum(center, radius);

    if (visible) {
        uint drawIndex = atomicAdd(outCounter.drawCount, 1u);

        ClusterCommand src = inCommands.cmds[gId];
        IndirectCommand cmd;
        cmd.indexCount    = src.indexCount;
        cmd.instanceCount = 1;
        cmd.firstIndex    = src.firstIndex;
        cmd.vertexOffset  = int(src.firstVertex);
        cmd.firstInstance = src.instanceId;

        outDraws.drawCmds[drawIndex] = cmd;
    }
}
