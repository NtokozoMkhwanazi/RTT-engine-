#version 460
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_basic : require
/**
 * nanite_lod.comp — Multi-LOD Cluster Selection (Phase 3)
 *
 * Replaces the flat frustum-cull of Phase 2 with a DAG-hierarchy-aware
 * screen-space-error selector.  Each node in the cluster hierarchy carries
 * errorSelf / errorParent (world-space geometric deviation from its
 * simplified parent).  A node is rendered when its own SSE ≤ target pixel
 * error but its parent's SSE > target — producing a seamless crack-free
 * transition surface.
 *
 * AMD GCN/Vega optimisation: workgroup size 64 matches the Vega 10's
 * native 64-lane wavefront (Wave64), keeping subgroup ballot execution
 * in lock-step with the physical execution units.  One atomic per
 * subgroup instead of one per thread coalesces the counter writes.
 *
 * Struct is padded to 64 bytes (one Vega cache-line slot) to avoid UMA
 * cache-line-straddle faults. Mirrored in C++ as VkLODCluster (64 B).
 * Phase 3 is the LIVE dispatch path (m_naniteLodPipeline); Phase 2
 * (cluster_cull.comp) is the fallback when the LOD pipeline/buffer are absent.
 *
 * Hierarchy: each mesh contributes one root node (parentId=0, draws the whole
 * mesh, errorSelf = bounding-sphere radius = coarsest level) and N leaf nodes
 * (parentId=root, errorSelf=0 = exact geometry). At the default 1px target the
 * leaves render everywhere (identical to flat culling); raise `lodPixelError`
 * to activate distance culling (far mesh -> single root draw).
 */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define PI 3.14159265358979323846

struct LODCluster {
    vec4  sphereCenterRadius;  // xyz = center, w = radius
    float errorSelf;           // this cluster's geometric error
    float errorParent;         // parent cluster's geometric error
    uint  firstVertex;
    uint  firstIndex;
    uint  indexCount;
    uint  instanceId;
    uint  parentId;             // offset 40  (index of parent cluster, 0 for root)
    uint  pad0;                 // offset 44  (closes the 32-byte block)
    uvec4 extraPadding;         // offset 48  (16 bytes -> total struct 64 = Vega cache-line)
};

struct IndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4  viewProj;
    vec3  camPos;
    float fogDensity;
    vec3  fogColor;
} cam;

layout(set = 0, binding = 1, std430) readonly buffer LODClusterBuffer {
    LODCluster nodes[];
} inHierarchy;

layout(set = 0, binding = 2, std430) readonly buffer ClusterCommandBuffer {
    // Reuses the GPUClusterCommand layout for firstVertex/firstIndex/indexCount/instanceId
    uvec4 cmds[];  // [firstVertex, firstIndex, indexCount, instanceId]
} inCommands;

layout(set = 0, binding = 3, std430) writeonly buffer IndirectDrawBuffer {
    IndirectCommand drawCmds[];
} outDraws;

layout(set = 0, binding = 4, std430) buffer QueueCounter {
    uint drawCount;
} outCounter;

// --- Push constants (shared with cluster_cull.comp layout) ---
// offset 0:  uint  totalNodes        (total clusters / hierarchy nodes)
// offset 4:  float viewportW         (viewport width in pixels)
// offset 8:  float viewportH         (viewport height in pixels)
// offset 12: float lodPixelError     (target screen-space error in pixels)
layout(push_constant) uniform PushConstants {
    uint   totalNodes;
    float  viewportW;
    float  viewportH;
    float  lodPixelError;
} pc;

/*
 * Convert world-space error (meters) to screen-space pixel error.
 * Standard perspective formula:
 *   sse = (error * viewportHeight) / (2 * distance * tan(fov/2))
 */
float getScreenSpaceError(vec3 center, float radius, float worldError) {
    float dist = distance(cam.camPos, center);
    if (dist <= radius) return 0.0;   // camera inside cluster -> max detail (render)

    // vertical fov = 60 deg (must match engine camera; could be a UBO field)
    float fovY = 60.0 * PI / 180.0;
    float projectedError = (worldError * pc.viewportH) / (2.0 * dist * tan(fovY * 0.5));
    return projectedError;
}

// Extract frustum planes from viewProj (world-space, normals pointing inward)
vec4 extractFrustumPlane(int which) {
    vec4 rowX = cam.viewProj[0];
    vec4 rowY = cam.viewProj[1];
    vec4 rowZ = cam.viewProj[2];
    vec4 rowW = cam.viewProj[3];

    vec4 plane;
    if      (which == 0) plane = rowW + rowX;  // left
    else if (which == 1) plane = rowW - rowX;  // right
    else if (which == 2) plane = rowW + rowY;  // bottom
    else if (which == 3) plane = rowW - rowY;  // top
    else if (which == 4) plane = rowW + rowZ;  // near
    else            plane = rowW - rowZ;  // far

    float invLen = 1.0 / length(plane.xyz);
    return plane * invLen;
}

bool sphereInFrustum(vec3 center, float radius) {
    for (int i = 0; i < 6; ++i) {
        vec4 plane = extractFrustumPlane(i);
        if (dot(plane.xyz, center) + plane.w < -radius)
            return false;
    }
    return true;
}

void main() {
    uint gId = gl_GlobalInvocationID.x;
    if (gId >= pc.totalNodes) return;

    LODCluster node = inHierarchy.nodes[gId];
    vec3 center  = node.sphereCenterRadius.xyz;
    float radius = node.sphereCenterRadius.w;

    // 1. Core frustum culling (early out)
    if (!sphereInFrustum(center, radius)) return;

    // 2. Dynamic LOD evaluator
    float sseSelf   = getScreenSpaceError(center, radius, node.errorSelf);
    float sseParent = getScreenSpaceError(center, radius, node.errorParent);

    // Rule: render THIS node if own error is acceptable, but parent's is not.
    // For root nodes (errorParent = 0), always test own error.
    bool renderThis = false;
    if (node.parentId == 0) {
        // Root: render only if own error is within budget
        renderThis = (sseSelf <= pc.lodPixelError);
    } else {
        renderThis = (sseSelf <= pc.lodPixelError &&
                      sseParent > pc.lodPixelError);
    }

    if (renderThis) {
        // AMD Wave32 optimisation: instead of every active thread doing an
        // atomicAdd on outCounter.drawCount, we use subgroup ballot to count
        // the active threads in this Wave32, let the elected leader perform a
        // SINGLE atomicAdd for the whole subgroup, and broadcast the base
        // offset back to all lanes via subgroupBroadcastFirst.  This removes
        // register spills from atomics contention and keeps the full 32-lane
        // wavefront in lock-step.
        uvec4 activeBallot = subgroupBallot(renderThis);
        uint  waveCount    = subgroupBallotBitCount(activeBallot);

        uint waveBase = 0;
        if (subgroupElect()) {
            waveBase = atomicAdd(outCounter.drawCount, waveCount);
        }
        waveBase = subgroupBroadcastFirst(waveBase);

        uint threadOffset = subgroupBallotExclusiveBitCount(activeBallot);
        uint drawIndex    = waveBase + threadOffset;

        // APU safety: pin the WRITE index against totalNodes so a CPU mis-count
        // can never drive an out-of-bounds write into shared UMA memory.
        uint safeDraw = min(drawIndex, pc.totalNodes - 1u);

        // Each LOD node carries its own draw command (firstVertex/firstIndex/...),
        // so Phase 3 is self-contained in binding 1 (the hierarchy buffer).
        // Binding 2 (ClusterCommand) is consumed only by the Phase 2 fallback.
        IndirectCommand cmd;
        cmd.indexCount    = node.indexCount;
        cmd.instanceCount = 1;
        cmd.firstIndex    = node.firstIndex;
        cmd.vertexOffset  = int(node.firstVertex);
        cmd.firstInstance = node.instanceId;

        outDraws.drawCmds[safeDraw] = cmd;
    }
}
