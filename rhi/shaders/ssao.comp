#version 460
// ============================================================================
// Screen-Space Ambient Occlusion (Vulkan RHI, GLSL 4.6 compute)
// ----------------------------------------------------------------------------
// Two-pass screen-space AO that modulates the deferred lighting ambient term:
//   1. ssao.comp       : one coarse AO factor per pixel (R8) from the G-Buffer
//                        (scene depth + world normal) + a 16-sample kernel + a
//                        4x4 noise texture that randomizes the kernel rotation.
//   2. ssao_blur.comp  : a 4x4 bilateral blur (depth-weighted) to kill the
//                        kernel sampling noise, preserving normal/depth edges.
//
// Parity contract: the G-Buffer depth/normal textures come from the SAME
// geometry pass on GL and Vulkan, and the kernel + noise are generated by the
// shared RHI::generateSsao*() functions uploaded verbatim to both backends. The
// world-position reconstruction mirrors lighting.frag's
//   vec4 wp = inverse(viewProj) * vec4(ndc,1);  pos = wp.xyz/wp.w
// (Vulkan NDC z is [0,1], so ndc.z = depth directly). GL uses the twin
// shader (ndc.z = depth*2-1) with the Vulkan GL-NDC-projection baked into the
// same viewProj the deferred geometry pass used, so both backends reconstruct
// the SAME world position per pixel -> identical AO output.
// ============================================================================
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uDepth;      // R32G32_FLOAT or D32 scene depth
layout(set = 0, binding = 1) uniform sampler2D uNormal;     // RGBA16f world-space normal (RGB) + rough (A)
layout(set = 0, binding = 2) uniform sampler2D uNoise;      // 4x4 RG8 noise
layout(std140, set = 0, binding = 3) uniform SsaoUBO {
    mat4 viewProj;
    mat4 invViewProj;
    vec3 samples[16];       // hemisphere kernel, already radius-scaled on the CPU
};
layout(set = 0, binding = 4, r8) uniform writeonly image2D outAO;

const float kRadius    = 0.5f;   // world-units occlusion radius
const float kBias      = 0.001f; // avoid self-occlusion at grazing angles

vec3 worldPosFromDepth(vec2 uv, float d) {
    // Vulkan NDC z covers [0,1].
    vec4 clip = vec4(uv * 2.0 - 1.0, d, 1.0);
    vec4 wp = invViewProj * clip;
    return wp.xyz / wp.w;
}

void main() {
    ivec2 p  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(outAO);
    if (p.x >= sz.x || p.y >= sz.y) return;

    vec2  uv   = (vec2(p) + 0.5) / vec2(sz);
    float d    = texture(uDepth, uv).r;
    if (d >= 1.0) { imageStore(outAO, p, vec4(1.0)); return; }   // background -> unoccluded

    vec3 pos = worldPosFromDepth(uv, d);
    vec3 N   = normalize(texture(uNormal, uv).rgb);

    // Randomize the kernel rotation per-pixel via the tiled noise texture.
    ivec2 nsz = textureSize(uNoise, 0);
    vec2 rnd  = texture(uNoise, uv * vec2(sz) / vec2(nsz)).rg;
    // Build an orthonormal basis around N and spin it by the 2D noise vector.
    vec3 tang = abs(N.z) < 0.99 ? cross(N, vec3(0.0, 0.0, 1.0))
                                : cross(N, vec3(0.0, 1.0, 0.0));
    tang = normalize(tang);
    vec3 bitang = normalize(cross(N, tang));
    float c = rnd.r, s = rnd.g;
    vec3 T =  tang * c - bitang * s;
    vec3 B =  tang * s + bitang * c;
    mat3 basis = mat3(T, B, N);

    float ao = 0.0;
    for (int i = 0; i < 16; ++i) {
        vec3 spt = pos + basis * samples[i];              // world-space sample point
        vec4 sp  = viewProj * vec4(spt, 1.0);
        sp /= sp.w;
        vec2 suv = sp.xy * 0.5 + 0.5;
        if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) continue;
        float sd = texture(uDepth, suv).r;
        if (sd >= 1.0) continue;                            // sample hits background
        // World-space Z for "closer to camera" (camera at +Z, looking -Z:
        // larger Z = closer), matching the reconstructed geometry depth.
        float sZ = worldPosFromDepth(suv, sd).z;
        float rangeCheck = smoothstep(0.0, 1.0, kRadius / (abs(pos.z - sZ) + 1e-3));
        // Geometry closer to the camera than the sample point => an occluder.
        // (Camera sits at +Z looking down -Z, so larger world-Z is closer.)
        ao += ((sZ > spt.z + kBias) ? 1.0 : 0.0) * rangeCheck;
    }
    ao = 1.0 - clamp(ao / 16.0, 0.0, 1.0);
    imageStore(outAO, p, vec4(ao));
}
